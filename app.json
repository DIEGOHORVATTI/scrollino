{
  "expo": {
    "name": "Rolo",
    "slug": "rolo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rolo",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.diegohorvatti.rolo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#14110d",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#14110D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "diegohorvatti",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {}
    },
    "ios": {}
  }
}
