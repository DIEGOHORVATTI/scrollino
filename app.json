{
  "expo": {
    "name": "Scrollino",
    "slug": "scrollino",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scrollino",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.diegohorvatti.scrollino",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#14110d",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#14110D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "diegohorvatti",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a5d955e-5c6d-41e6-bb6a-a030519664d9"
      }
    },
    "ios": {
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true
      }
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 4000,
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "url": "https://u.expo.dev/7a5d955e-5c6d-41e6-bb6a-a030519664d9"
    }
  }
}
